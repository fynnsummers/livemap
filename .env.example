# Kopieren nach .env und das Datenbankpasswort setzen.
# Das Konto für die Oberfläche entsteht beim ersten Aufruf im Browser.

POSTGRES_DB=livemap
POSTGRES_USER=livemap
POSTGRES_PASSWORD=

LIVEMAP_NAME=
LIVEMAP_HOSTER=ionos
LIVEMAP_HOSTER_NAME=IONOS
LIVEMAP_LAT=52.52
LIVEMAP_LON=13.405
LIVEMAP_OWN_IPS=
LIVEMAP_NGINX=/var/log/nginx/access.log
LIVEMAP_F2B=/var/log/fail2ban.log
LIVEMAP_F2B_SUDO=0
LIVEMAP_SECURE_COOKIE=1
LIVEMAP_SESSION_DAYS=14
